{
  "name": "multiplayer-voxel-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer-first voxel shooter web MVP: authoritative Colyseus server + Next.js + React Three Fiber + client-side prediction",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thefalley/minecraft-shooter-online.git"
  },
  "homepage": "https://minecraft-shooter-online-web.vercel.app",
  "bugs": {
    "url": "https://github.com/Thefalley/minecraft-shooter-online/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @mvp/web dev",
    "dev:server": "pnpm --filter @mvp/server dev",
    "dev:game": "pnpm --filter @mvp/game dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:online": "node tests/online.mjs",
    "clean": "pnpm -r exec rm -rf dist .next node_modules && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
