{
  "name": "@mvp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire as ___createRequire } from 'module';const require=___createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "0.16.3",
    "@colyseus/schema": "3.0.40",
    "@colyseus/ws-transport": "0.16.3",
    "@mvp/shared": "workspace:*",
    "cors": "2.8.5",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
